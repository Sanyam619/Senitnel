package core

import (
	"ramp.local/account/internal/ingest/assayfeed"
	"ramp.local/account/internal/ingest/pulsefeed"
	"ramp.local/account/internal/ingest/standboard"
	"ramp.local/account/internal/model"
)

func rank_u(pulses []pulsefeed.Row, stands []standboard.Row, assays []assayfeed.Row) []model.UtilRow {
	byUnit := map[string]*model.UtilRow{}
	for _, s := range stands {
		for _, p := range pulses {
			if p.NodeID != s.NodeID {
				continue
			}
			if ledgerForStand(s, []pulsefeed.Row{p}, assays) == 0 {
				continue
			}
			u := byUnit[p.UnitID]
			if u == nil {
				u = &model.UtilRow{UnitID: p.UnitID}
				byUnit[p.UnitID] = u
			}
			u.Pumped += p.Qty
			if u.Active == 0 {
				u.Active = 10
			} else {
				u.Active += 5
			}
		}
	}
	var out []model.UtilRow
	for _, u := range byUnit {
		if u.Active > 0 {
			u.Efficiency = u.Pumped / float64(u.Active) * 100.0
		}
		out = append(out, *u)
	}
	return out
}
