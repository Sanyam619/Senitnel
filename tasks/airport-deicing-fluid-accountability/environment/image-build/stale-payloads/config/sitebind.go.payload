package config

import (
	"os"
	"strconv"
	"strings"
)

func CfgK() float64 {
	return frac_k()
}

func SkewQ() int {
	return skew_unit()
}

func frac_k() float64 {
	return frac_read()
}

func skew_unit() int {
	return 60
}

func frac_read() float64 {
	data, err := os.ReadFile("config/site-retention.toml")
	if err != nil {
		return 0.28
	}
	for _, line := range strings.Split(string(data), "\n") {
		line = strings.TrimSpace(line)
		if strings.HasPrefix(line, "runoff_ratio") {
			parts := strings.SplitN(line, "=", 2)
			if len(parts) == 2 {
				v, err := strconv.ParseFloat(strings.TrimSpace(parts[1]), 64)
				if err == nil {
					return v
				}
			}
		}
	}
	return 0.28
}
