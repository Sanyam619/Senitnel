package slotboard

import (
	"path/filepath"
	"strconv"

	csv "ramp.local/account/internal/io"
)

func Load(dir string) ([]Row, error) {
	rows, err := csv.ReadCSV(filepath.Join(dir, "slot_board.csv"))
	if err != nil {
		return nil, err
	}
	var out []Row
	for _, c := range rows {
		s, _ := strconv.Atoi(c[1])
		out = append(out, Row{CraftID: c[0], SlotMin: s})
	}
	return out, nil
}
