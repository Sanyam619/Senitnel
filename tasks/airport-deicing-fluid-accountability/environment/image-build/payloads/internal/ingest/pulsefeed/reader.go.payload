package pulsefeed

import (
	"path/filepath"
	"strconv"

	csv "ramp.local/account/internal/io"
)

func Load(dir string) ([]Row, error) {
	rows, err := csv.ReadCSV(filepath.Join(dir, "pulse_feed.csv"))
	if err != nil {
		return nil, err
	}
	var out []Row
	for _, c := range rows {
		qty, _ := strconv.ParseFloat(c[3], 64)
		ts, _ := strconv.Atoi(c[1])
		out = append(out, Row{UnitID: c[0], TS: ts, NodeID: c[2], Qty: qty})
	}
	return out, nil
}
