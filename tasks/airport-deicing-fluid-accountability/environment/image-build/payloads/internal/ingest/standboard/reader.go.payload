package standboard

import (
	"path/filepath"
	"strconv"

	csv "ramp.local/account/internal/io"
)

func Load(dir string) ([]Row, error) {
	rows, err := csv.ReadCSV(filepath.Join(dir, "stand_board.csv"))
	if err != nil {
		return nil, err
	}
	var out []Row
	for _, c := range rows {
		ws, _ := strconv.Atoi(c[2])
		we, _ := strconv.Atoi(c[3])
		out = append(out, Row{CraftID: c[0], NodeID: c[1], WinStart: ws, WinEnd: we, Code: c[4]})
	}
	return out, nil
}
