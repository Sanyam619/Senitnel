package assayfeed

import (
	"path/filepath"
	"strconv"

	csv "ramp.local/account/internal/io"
)

func Load(dir string) ([]Row, error) {
	rows, err := csv.ReadCSV(filepath.Join(dir, "assay_feed.csv"))
	if err != nil {
		return nil, err
	}
	var out []Row
	for _, c := range rows {
		pct, _ := strconv.ParseFloat(c[2], 64)
		ts, _ := strconv.Atoi(c[1])
		out = append(out, Row{NodeID: c[0], TS: ts, Pct: pct})
	}
	return out, nil
}
