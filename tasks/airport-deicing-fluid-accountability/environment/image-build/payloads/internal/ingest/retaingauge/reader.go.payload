package retaingauge

import (
	"path/filepath"
	"strconv"

	csv "ramp.local/account/internal/io"
)

func Load(dir string) ([]Row, error) {
	rows, err := csv.ReadCSV(filepath.Join(dir, "retain_gauge.csv"))
	if err != nil {
		return nil, err
	}
	var out []Row
	for _, c := range rows {
		cap, _ := strconv.ParseFloat(c[1], 64)
		base, _ := strconv.ParseFloat(c[2], 64)
		out = append(out, Row{NodeID: c[0], CapQty: cap, BaseQty: base})
	}
	return out, nil
}
