package core

import (
	"ramp.local/account/internal/ingest/assayfeed"
	"ramp.local/account/internal/ingest/pulsefeed"
	"ramp.local/account/internal/ingest/standboard"
	"ramp.local/account/joinpipe"
	"ramp.local/account/mixroute"
)

func assayPct(rows []assayfeed.Row, node string) float64 {
	for _, r := range rows {
		if r.NodeID == node {
			return r.Pct
		}
	}
	return 100.0
}

func ledgerForStand(s standboard.Row, pulses []pulsefeed.Row, assays []assayfeed.Row) float64 {
	var sum float64
	pct := assayPct(assays, s.NodeID)
	for _, p := range pulses {
		if p.NodeID != s.NodeID {
			continue
		}
		if !joinpipe.PipeJoin(p.TS, s.WinStart, s.WinEnd) {
			continue
		}
		sum += mixroute.RouteScale(p.Qty, pct, s.Code)
	}
	return sum
}
