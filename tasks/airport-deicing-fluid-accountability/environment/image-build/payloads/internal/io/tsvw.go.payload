package io

import (
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"

	"ramp.local/account/internal/model"
)

func WriteUtil(path string, rows []model.UtilRow) error {
	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
		return err
	}
	sort.Slice(rows, func(i, j int) bool { return rows[i].UnitID < rows[j].UnitID })
	lines := []string{"truck_id\tactive_min\tgallons_pumped\tefficiency_pct"}
	for _, r := range rows {
		lines = append(lines, fmt.Sprintf("%s\t%d\t%.2f\t%.2f",
			r.UnitID, r.Active, r.Pumped, r.Efficiency))
	}
	return os.WriteFile(path, []byte(strings.Join(lines, "\n")+"\n"), 0o644)
}
