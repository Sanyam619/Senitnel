package main

import (
	"fmt"
	"os"

	"ramp.local/account/internal/core"
)

func main() {
	if len(os.Args) < 3 {
		fmt.Fprintf(os.Stderr, "usage: rampd <shift> <root>\n")
		os.Exit(2)
	}
	if err := core.RunShift(os.Args[1], os.Args[2]); err != nil {
		fmt.Fprintf(os.Stderr, "shift failed: %v\n", err)
		os.Exit(1)
	}
}
