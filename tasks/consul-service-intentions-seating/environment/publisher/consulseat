#!/bin/bash
# consulseat — publishes the mesh seating ledger from the live work tables.
set -euo pipefail

OPS="${CS_OPS:-/var/lib/consul/ops}"
DEF_D="${DEF_D:-/app/data/consul}"
EX_D="${EX_D:-/var/lib/consul/ops/extra}"
REPORT="${CS_REPORT:-/output/consul-seat.json}"
WORK="${OPS}/live"
ETC_RT="${CS_ETC:-/etc/consul.d}/runtime"

mkdir -p "$(dirname "$REPORT")" "$ETC_RT" "$WORK"

declare -A d_node=() b_node=() t_node=() t_gen=() r_flag=() f_val=() seen=()

shopt -s nullglob
for root in "$DEF_D" "$EX_D"; do
  [[ -d "$root" ]] || continue
  for f in "$root"/*.json; do
    nm="$(jq -r '.service.name // empty' "$f")"
    [[ -n "$nm" ]] || continue
    d_node["$nm"]="$(jq -r '.service.node // ""' "$f")"
    seen["$nm"]=1
  done
done
for f in "$OPS"/floors/*.floor; do
  base="$(basename "$f" .floor)"
  f_val["$base"]="$(tr -d '[:space:]' <"$f")"
done
shopt -u nullglob

if [[ -f "$WORK/bind.tsv" ]]; then
  while IFS=$'\t' read -r a b _rest || [[ -n "${a:-}" ]]; do
    [[ -z "${a:-}" ]] && continue
    b_node["$a"]="$b"
    seen["$a"]=1
  done <"$WORK/bind.tsv"
fi

if [[ -f "$WORK/tip.tsv" ]]; then
  while IFS=$'\t' read -r a b c _rest || [[ -n "${a:-}" ]]; do
    [[ -z "${a:-}" ]] && continue
    t_node["$a"]="$b"
    t_gen["$a"]="$c"
    seen["$a"]=1
  done <"$WORK/tip.tsv"
fi

if [[ -f "$WORK/reg.tsv" ]]; then
  while IFS=$'\t' read -r a b _rest || [[ -n "${a:-}" ]]; do
    [[ -z "${a:-}" ]] && continue
    r_flag["$a"]="$b"
  done <"$WORK/reg.tsv"
fi

declare -A pair_live=()
if [[ -f "$WORK/cmt.tsv" ]]; then
  while IFS=$'\t' read -r a b _rest || [[ -n "${a:-}" ]]; do
    [[ -z "${a:-}" || -z "${b:-}" ]] && continue
    pair_live["${a}|${b}"]=1
  done <"$WORK/cmt.tsv"
fi

agree=1
reg_total=0
svc_tmp="$(mktemp)"
: >"$svc_tmp"
for nm in $(printf '%s\n' "${!seen[@]}" | LC_ALL=C sort); do
  node="${b_node[$nm]:-${d_node[$nm]:-}}"
  gen="${t_gen[$nm]:-0}"
  flag="${r_flag[$nm]:-0}"
  want=0
  if [[ -n "${t_node[$nm]:-}" && "$node" == "${t_node[$nm]}" ]] \
    && [[ "$gen" -ge "${f_val[$nm]:-0}" ]]; then
    want=1
  fi
  [[ "$flag" == "1" ]] || flag=0
  if [[ "$flag" != "$want" ]]; then
    agree=0
  fi
  registered=false
  if [[ "$flag" == "1" ]]; then
    registered=true
    reg_total=$((reg_total + 1))
  fi
  jq -nc \
    --arg name "$nm" \
    --arg node "$node" \
    --argjson generation "$gen" \
    --argjson registered "$registered" \
    '{name:$name,node:$node,generation:$generation,registered:$registered}' \
    >>"$svc_tmp"
done

int_tmp="$(mktemp)"
: >"$int_tmp"
declare -A pair_out=()
if [[ -f "$WORK/acts.tsv" ]]; then
  while IFS=$'\t' read -r src dst action || [[ -n "${src:-}" ]]; do
    [[ -z "${src:-}" || -z "${dst:-}" ]] && continue
    printf '%s\t%s\t%s\n' "$src" "$dst" "$action"
  done <"$WORK/acts.tsv" | LC_ALL=C sort -t$'\t' -k1,1 -k2,2 >"$int_tmp.sorted"
  while IFS=$'\t' read -r src dst action || [[ -n "${src:-}" ]]; do
    [[ -z "${src:-}" ]] && continue
    key="${src}|${dst}"
    if [[ -n "${pair_out[$key]:-}" ]]; then
      agree=0
      continue
    fi
    pair_out["$key"]=1
    case "$action" in
      allow|deny) ;;
      *) agree=0 ;;
    esac
    honored=false
    if [[ -n "${pair_live[$key]:-}" ]] \
      && [[ "${r_flag[$src]:-0}" == "1" ]] \
      && [[ "${r_flag[$dst]:-0}" == "1" ]]; then
      honored=true
    fi
    jq -nc \
      --arg source "$src" \
      --arg destination "$dst" \
      --arg action "$action" \
      --argjson honored "$honored" \
      '{source:$source,destination:$destination,action:$action,honored:$honored}' \
      >>"$int_tmp"
  done <"$int_tmp.sorted"
  rm -f "$int_tmp.sorted"
fi

target_gen=0
[[ -f "$OPS/state/generation.target" ]] &&
  target_gen="$(tr -d '[:space:]' <"$OPS/state/generation.target")"
seal_gen=""
seal_mode=""
if [[ -f "$OPS/state/cutover.ok" ]]; then
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '[:space:]')"
    [[ -z "$line" ]] && continue
    case "$line" in
      gen=*) seal_gen="${line#gen=}" ;;
      mode=*) seal_mode="${line#mode=}" ;;
    esac
  done <"$OPS/state/cutover.ok"
fi
if [[ "$seal_gen" != "$target_gen" || "$seal_mode" != "seal" ]]; then
  agree=0
fi
if [[ "$reg_total" -lt 1 ]]; then
  agree=0
fi

seat_json=false
[[ "$agree" -eq 1 ]] && seat_json=true

jq -nc \
  --slurpfile svc "$svc_tmp" \
  --slurpfile ints "$int_tmp" \
  --argjson seat_ok "$seat_json" \
  '{schema_tag:"consul-seat-v1",services:$svc,intentions:$ints,seat_ok:$seat_ok}' \
  >"$REPORT"

{
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$(jq -r '.registered' <<<"$line")" == "true" ]] || continue
    printf '%s=%s\n' "$(jq -r '.name' <<<"$line")" "$(jq -r '.node' <<<"$line")"
  done <"$svc_tmp"
} | LC_ALL=C sort >"$ETC_RT/catalog.map"

rm -f "$svc_tmp" "$int_tmp"
