#!/bin/bash
# Surface health — TTL check files only.
set -euo pipefail
CHK="${CHECK_D:-/var/lib/consul/checks}"
total=0
passing=0
shopt -s nullglob
for f in "$CHK"/*.ttl; do
  total=$((total + 1))
  if grep -qE '^status[[:space:]]*=[[:space:]]*passing' "$f"; then
    passing=$((passing + 1))
  fi
done
shopt -u nullglob
if [[ "$total" -gt 0 && "$passing" -eq "$total" ]]; then
  echo "catalog-passing"
  exit 0
fi
echo "catalog-critical"
exit 1
