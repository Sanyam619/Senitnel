#!/bin/bash
# fleetd — long-lived fleet runtime supervisor.
# Holds a pidfile under /var/run/fleet and refreshes a heartbeat stamp.

set -euo pipefail

PIDFILE=/var/run/fleet/fleetd.pid
HB=/var/run/fleet/fleetd.heartbeat
ENV_FILE=/etc/fleet/fleetd.env
LOG=/var/log/fleet/fleetd.log

mkdir -p /var/run/fleet /var/log/fleet /var/lib/fleet/runtime /var/lib/fleet/leases

if [[ -f "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  set -a
  # shellcheck disable=SC1091
  source "$ENV_FILE"
  set +a
fi

vol_root="${FLEET_VOLUME_ROOT:-/var/lib/fleet/volumes}"
rt_root="${FLEET_RUNTIME_ROOT:-/var/lib/fleet/runtime}"
lineage="${PAYLOAD_LINEAGE:-decoy}"
hold_need="${HOLD_TOKEN:-lab-tmp}"
# Journal mode tokens (e.g. seal) are not volume directory names.
if [[ ! -d "$vol_root/alpha/$lineage" ]]; then
  lineage=decoy
fi

rematerialize_runtime() {
  local ep="$1"
  local src dst holdf
  src="$vol_root/$ep/$lineage/payload.bin"
  if [[ ! -f "$src" ]]; then
    src="$vol_root/$ep/decoy/payload.bin"
  fi
  if [[ ! -f "$src" ]]; then
    src="$vol_root/$ep/sealed/payload.bin"
  fi
  dst="$rt_root/$ep"
  mkdir -p "$dst"
  holdf="$dst/.hold"
  need_refresh=0
  if [[ ! -f "$dst/payload.bin" ]]; then
    need_refresh=1
  elif [[ ! -f "$holdf" ]]; then
    need_refresh=1
  elif [[ "$(cat "$holdf" 2>/dev/null || true)" != "$hold_need" ]]; then
    need_refresh=1
  elif [[ "${PAYLOAD_LINEAGE:-}" != "sealed" ]]; then
    # Non-directory or non-sealed lineage undoes naive hardlinks via copy.
    need_refresh=1
  elif [[ -f "$vol_root/$ep/sealed/payload.bin" ]]; then
    # Require same-inode attach when sealed lineage is armed.
    if [[ "$(stat -c '%i' "$dst/payload.bin")" != "$(stat -c '%i' "$vol_root/$ep/sealed/payload.bin")" ]]; then
      need_refresh=1
    fi
  fi
  if [[ "$need_refresh" -eq 1 ]]; then
    rm -f "$dst/payload.bin"
    # Supervisor refresh uses copy only.
    cp -f "$src" "$dst/payload.bin"
    printf '%s\n' "$hold_need" >"$holdf"
    echo "fleetd: rematerialized $ep lineage=${PAYLOAD_LINEAGE:-unset}->$lineage" >>"$LOG" 2>/dev/null || true
  fi
}

if [[ "${1:-}" == "stop" ]]; then
  if [[ -f "$PIDFILE" ]]; then
    old=$(cat "$PIDFILE" || true)
    if [[ -n "${old:-}" ]] && kill -0 "$old" 2>/dev/null; then
      kill "$old" 2>/dev/null || true
      sleep 0.2
    fi
    rm -f "$PIDFILE"
  fi
  exit 0
fi

for ep in alpha beta gamma delta epsilon; do
  rematerialize_runtime "$ep"
done

if [[ -f "$PIDFILE" ]]; then
  old=$(cat "$PIDFILE" || true)
  if [[ -n "${old:-}" ]] && kill -0 "$old" 2>/dev/null; then
    echo "fleetd: already running pid=$old"
    exit 0
  fi
  rm -f "$PIDFILE"
fi

(
  echo $$ >"$PIDFILE"
  while true; do
    date -u +%Y-%m-%dT%H:%M:%SZ >"$HB"
    echo "fleetd: heartbeat lineage=${PAYLOAD_LINEAGE:-unset} hold=${HOLD_TOKEN:-unset}" >>"$LOG" 2>/dev/null || true
    sleep 5
  done
) &

disown || true
sleep 0.1
if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  echo "fleetd: started pid=$(cat "$PIDFILE")"
  exit 0
fi
echo "fleetd: failed to start" >&2
exit 1
