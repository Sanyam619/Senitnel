#!/bin/bash
# fleethealth — surface-only maintenance probe.
# Reports green when episode exports, volume trees, and /etc/fleet exist.
# Does not validate drop-in fold, journal cutover, generation, holds, or gates.

set -euo pipefail
APP=/app
EPS="$APP/data/episodes"
ok=1

for ep in alpha beta gamma delta epsilon; do
  if [[ ! -d "$EPS/$ep" ]]; then
    echo "fleethealth: missing $ep"
    ok=0
  elif [[ ! -f "$EPS/$ep/volume_seal.json" ]]; then
    echo "fleethealth: $ep seal record absent"
    ok=0
  fi
done

if [[ ! -d /etc/fleet ]]; then
  echo "fleethealth: /etc/fleet absent"
  ok=0
fi

if [[ ! -d /var/lib/fleet/volumes ]]; then
  echo "fleethealth: volume tree absent"
  ok=0
fi

if [[ ! -f /var/lib/fleet/ops/journal.jsonl ]]; then
  echo "fleethealth: journal absent"
  ok=0
fi

# Intentionally ignore effective policy / gen / hold / gate correctness.
if [[ "$ok" -eq 1 ]]; then
  echo "fleethealth: OK — episode exports present, fleet paths visible"
  exit 0
fi
echo "fleethealth: DEGRADED"
exit 1
