#!/usr/bin/env bash
# Fast health view over the captured sweep. Greedy read, no fusion applied.
set -euo pipefail

SWEEP=/app/data/fixtures/probe_ok.json
BANDS=/app/docs/asr_bands.md

python3 - "$SWEEP" "$BANDS" <<'PY'
import json
import sys

sweep = json.load(open(sys.argv[1], encoding="utf-8"))
bands = {}
for line in open(sys.argv[2], encoding="utf-8"):
    line = line.strip()
    if not line.startswith("|"):
        continue
    cells = [c.strip() for c in line.strip("|").split("|")]
    if len(cells) != 5:
        continue
    try:
        nums = [float(c) for c in cells[1:]]
    except ValueError:
        continue
    bands[cells[0]] = nums

print(f"captured {sweep['captured']}  view: {sweep['view']}")
ok = True
for row in sweep["slices"]:
    band = bands.get(row["id"])
    if band is None:
        continue
    inside = band[0] <= row["wer"] <= band[1] and band[2] <= row["cer"] <= band[3]
    ok = ok and inside
    mark = "in" if inside else "out"
    print(f"  {row['id']:8s} wer={row['wer']:.4f} cer={row['cer']:.4f} {mark}")
print("greedy check: pass" if ok else "greedy check: attention")
PY
