#!/bin/bash
# Surface health probe. Reports loaded path units only; it does not consult
# durable watch tips, generation floors, watch generations, DirectoryNotEmpty
# exclusions, or the trigger journal.
set -euo pipefail
MAP="${LOADED_MAP:-/run/systemd/watch-seat/loaded.map}"
if [[ -f "$MAP" ]] && grep -q 'ARMED' "$MAP"; then
  echo "WATCH-OK"
  exit 0
fi
echo "DOWN"
exit 1
