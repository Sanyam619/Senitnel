#!/bin/bash
set -euo pipefail

ENV_FILE="${SAMBA_DESKD_ENV:-/etc/samba/deskd.env}"
ROOT="${SAMBA_VAR:-/var/lib/samba}"
ROSTER="${IDMAP_ROSTER:-/etc/samba/idmap.roster}"
ETC="${SAMBA_ETC:-/etc/samba}"
LOG=/var/log/samba/deskd.log
PIDFILE=/var/run/samba/deskd.pid

mkdir -p /var/run/samba /var/log/samba "$ROOT/attach" "$ROOT/origins"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

lineage="${PAYLOAD_LINEAGE:-decoy}"
hold_need="${HOLD_TOKEN:-lab-tmp}"
if [[ "$lineage" != "sealed" ]]; then
  lineage=decoy
fi

rematerialize() {
  local nm="$1"
  local src dst sealed
  sealed="$ROOT/origins/$nm/sealed/map.bin"
  src="$ROOT/origins/$nm/$lineage/map.bin"
  [[ -f "$src" ]] || src="$ROOT/origins/$nm/decoy/map.bin"
  [[ -f "$src" ]] || src="$sealed"
  dst="$ROOT/attach/$nm.bin"
  mkdir -p "$ROOT/attach"
  need=0
  if [[ ! -f "$dst" ]]; then
    need=1
  elif [[ "${PAYLOAD_LINEAGE:-}" != "sealed" ]]; then
    need=1
  elif [[ "$(cat "$ROOT/attach/.hold.$nm" 2>/dev/null || true)" != "$hold_need" ]]; then
    need=1
  elif [[ "$(stat -c '%i' "$dst" 2>/dev/null || true)" != "$(stat -c '%i' "$sealed" 2>/dev/null || true)" ]]; then
    need=1
  fi
  if [[ "$need" -eq 1 ]]; then
    rm -f "$dst"
    cp -f "$src" "$dst"
    printf '%s\n' "$hold_need" >"$ROOT/attach/.hold.$nm"
    echo "deskd: rematerialized $nm lineage=${PAYLOAD_LINEAGE:-unset}->$lineage" >>"$LOG" 2>/dev/null || true
  fi
}

while read -r nm sid lo hi uid || [[ -n "${nm:-}" ]]; do
  [[ -z "${nm:-}" || "$nm" == \#* ]] && continue
  rematerialize "$nm"
done <"$ROSTER"

if [[ ! -f "$ROOT/meta/cutover.ok" ]]; then
  if [[ -f "$ROOT/journal/legacy.prefer" ]]; then
    cp -f "$ROOT/journal/legacy.prefer" "$ETC/smb.conf.d/40-legacy.conf"
  fi
fi

echo $$ >"$PIDFILE"
date -u +%Y-%m-%dT%H:%M:%SZ >/var/run/samba/deskd.heartbeat
echo "deskd: refreshed lineage=${PAYLOAD_LINEAGE:-unset} hold=${HOLD_TOKEN:-unset}"
