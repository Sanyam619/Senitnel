#!/bin/bash
# seatctl — correct publisher from prepared state.
set -euo pipefail

OUT="${SEAT_OUT:-/output/ldap-seat.json}"
ROSTER="${ROSTER:-/etc/ldap/roster.list}"
ROOT="${LDAP_ROOT:-/var/lib/ldap}"
STATE="$ROOT/state"
EFF="${EFF_POLICY:-/etc/ldap/effective.conf}"

mkdir -p "$(dirname "$OUT")"

python3 - "$OUT" "$ROSTER" "$STATE" "$EFF" <<'PY'
import json
import sys
from pathlib import Path

out, roster, state, eff = map(Path, sys.argv[1:])
rows = []
for ln in roster.read_text().splitlines():
    ln = ln.strip()
    if not ln or ln.startswith("#"):
        continue
    parts = ln.split("\t")
    rows.append((parts[0], parts[1] if len(parts) > 1 else f"dc={parts[0]},dc=lab"))

prov = ""
if eff.exists():
    for line in eff.read_text().splitlines():
        line = line.strip()
        if line.startswith("providerURI="):
            prov = line.split("=", 1)[1]

holds = []
holds_tsv = state / "holds.tsv"
if holds_tsv.exists():
    for line in holds_tsv.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            holds.append({"suffix": parts[1], "until_epoch": int(parts[2])})
holds.sort(key=lambda h: h["suffix"])

consumers = []
ok = True
for name, suffix in rows:
    gen_p = state / f"pub_{name}.gen"
    gen = int(gen_p.read_text().strip()) if gen_p.exists() else 0
    csn_p = state / f"pub_{name}.csn"
    csn = csn_p.read_text().strip() if csn_p.exists() else ""
    elig = (state / f"elig_{name}").exists() and (state / f"elig_{name}").read_text().strip() == "1"
    blocked = (state / f"hold_block_{name}").exists() and (state / f"hold_block_{name}").read_text().strip() == "1"
    tip_csn_p = state / f"tip_{name}.csn"
    tip_csn = tip_csn_p.read_text().strip() if tip_csn_p.exists() else ""
    csn_match = bool(csn) and csn == tip_csn
    bound = bool(elig and not blocked and csn_match and prov and "surface-decoy" not in prov)
    if bound != (elig and not blocked and csn_match and bool(prov) and "surface-decoy" not in prov):
        ok = False
    if not csn_match or not prov or "surface-decoy" in prov:
        if bound:
            ok = False
    consumers.append(
        {
            "name": name,
            "provider": prov,
            "contextCSN": csn,
            "generation": gen,
            "bound": bound,
        }
    )

for c in consumers:
    name = c["name"]
    elig = (state / f"elig_{name}").exists() and (state / f"elig_{name}").read_text().strip() == "1"
    blocked = (state / f"hold_block_{name}").exists() and (state / f"hold_block_{name}").read_text().strip() == "1"
    tip_csn = (state / f"tip_{name}.csn").read_text().strip() if (state / f"tip_{name}.csn").exists() else ""
    expect = bool(elig and not blocked and c["contextCSN"] == tip_csn and prov and "surface-decoy" not in prov)
    if c["bound"] != expect:
        ok = False
    if "surface-decoy" in c.get("provider", ""):
        ok = False

doc = {
    "schema_tag": "ldap-seat-v1",
    "consumers": consumers,
    "holds": holds,
    "sync_ok": ok,
}
out.write_text(json.dumps(doc, indent=2) + "\n")
PY
