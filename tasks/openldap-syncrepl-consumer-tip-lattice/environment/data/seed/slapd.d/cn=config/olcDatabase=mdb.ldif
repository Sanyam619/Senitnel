dn: olcDatabase={1}mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: {1}mdb
olcSuffix: dc=lab
olcDbDirectory: /var/lib/ldap
olcSyncrepl: rid=001 provider=ldap://surface-decoy.lab:389 bindmethod=simple binddn="cn=sync,dc=lab" searchbase="dc=alpha,dc=lab" type=refreshAndPersist retry="5 5 300 +"
olcSyncrepl: rid=002 provider=ldap://surface-decoy.lab:389 bindmethod=simple binddn="cn=sync,dc=lab" searchbase="dc=beta,dc=lab" type=refreshAndPersist retry="5 5 300 +"
olcSyncrepl: rid=003 provider=ldap://surface-decoy.lab:389 bindmethod=simple binddn="cn=sync,dc=lab" searchbase="dc=gamma,dc=lab" type=refreshAndPersist retry="5 5 300 +"
olcSyncrepl: rid=004 provider=ldap://surface-decoy.lab:389 bindmethod=simple binddn="cn=sync,dc=lab" searchbase="dc=delta,dc=lab" type=refreshAndPersist retry="5 5 300 +"
olcSyncrepl: rid=005 provider=ldap://surface-decoy.lab:389 bindmethod=simple binddn="cn=sync,dc=lab" searchbase="dc=epsilon,dc=lab" type=refreshAndPersist retry="5 5 300 +"
