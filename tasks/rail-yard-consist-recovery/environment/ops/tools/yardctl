#!/usr/bin/env python3
"""Yard consist report CLI."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, "/app/ops/scripts")
import yard_lib  # noqa: E402


def main() -> None:
    if len(sys.argv) < 2:
        raise SystemExit("usage: yardctl status|report --out PATH")
    cmd = sys.argv[1]
    if cmd == "status":
        report = yard_lib.build_report()
        print(json.dumps({"replay_seq": report["replay_seq"]}))
        return
    if cmd == "report":
        if "--out" not in sys.argv:
            raise SystemExit("report requires --out")
        out = Path(sys.argv[sys.argv.index("--out") + 1])
        report = yard_lib.build_report()
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(report, indent=2) + "\n")
        return
    raise SystemExit(f"unknown subcommand {cmd!r}")


if __name__ == "__main__":
    main()
