<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.hx</groupId>
  <artifactId>stack-bom</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>stack-bom</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <hx.release>modern</hx.release>
    <ship.wire.module>wire.alpha</ship.wire.module>
    <field.wire.module>wire.beta</field.wire.module>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.hx</groupId>
        <artifactId>marks</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hx</groupId>
        <artifactId>p7</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hx</groupId>
        <artifactId>m2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hx</groupId>
        <artifactId>n3</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hx.vendor</groupId>
        <artifactId>wire-alpha</artifactId>
        <version>1.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.hx.vendor</groupId>
        <artifactId>wire-beta</artifactId>
        <version>1.0.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
