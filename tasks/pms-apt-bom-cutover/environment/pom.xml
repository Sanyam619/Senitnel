<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.hx</groupId>
    <artifactId>stack-bom</artifactId>
    <version>1.0.0</version>
    <relativePath>stack-bom/pom.xml</relativePath>
  </parent>
  <artifactId>reactor-root</artifactId>
  <packaging>pom</packaging>
  <modules>
    <module>stack-bom</module>
    <module>marks</module>
    <module>p7</module>
    <module>m2</module>
    <module>n3</module>
    <module>r8</module>
  </modules>
  <profiles>
    <profile>
      <id>ship</id>
      <properties>
        <wire.module>${ship.wire.module}</wire.module>
        <wire.artifactId>wire-alpha</wire.artifactId>
      </properties>
    </profile>
    <profile>
      <id>field</id>
      <properties>
        <wire.module>${field.wire.module}</wire.module>
        <wire.artifactId>wire-beta</wire.artifactId>
      </properties>
    </profile>
  </profiles>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>21</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
