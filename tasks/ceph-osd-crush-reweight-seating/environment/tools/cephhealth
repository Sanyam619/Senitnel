#!/bin/bash
# Surface cluster monitor. Reports from the freshness of the placement
# image and the state plane; it does not audit sheet agreement.
set -euo pipefail
sv="${SD_VAR:-/var/lib/ceph/ops}"
if [[ -s "$sv/crushmap.bin" && -s "$sv/state/gen.live" ]]; then
  n=$(ls /etc/ceph/reweight.d 2>/dev/null | wc -l | tr -d ' ')
  echo "HEALTH_OK ${n} osds up/in; pools active+clean"
else
  echo "HEALTH_WARN placement image missing"
  exit 1
fi
