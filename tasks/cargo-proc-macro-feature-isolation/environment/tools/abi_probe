#!/usr/bin/env python3
"""Build the host matrix and emit /output/abi-matrix.json."""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path("/app")
OUT = Path("/output/abi-matrix.json")
MATRIX = ROOT / "ops" / "matrix.toml"
PKG = ROOT / "pkg"
SCHEMA = "abi-matrix-v1"


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True, check=False, **kwargs)


def parse_simple_toml_cells(path: Path) -> list[dict]:
    cells: list[dict] = []
    cur: dict | None = None
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line == "[[cells]]":
            if cur:
                cells.append(cur)
            cur = {}
            continue
        if cur is None or "=" not in line:
            continue
        key, val = [p.strip() for p in line.split("=", 1)]
        if val.startswith("["):
            inner = val.strip("[]")
            cur[key] = [x.strip().strip('"') for x in inner.split(",") if x.strip()]
        elif val in ("true", "false"):
            cur[key] = val == "true"
        else:
            cur[key] = val.strip('"')
    if cur:
        cells.append(cur)
    return cells


def cargo_target_dir(profile: str) -> Path:
    if profile == "release":
        return ROOT / "target" / "release"
    return ROOT / "target" / "debug"


def build_crate(crate_pkg: str, features: list[str], profile: str) -> tuple[bool, str]:
    feat = ",".join(features) if features else ""
    cmd = [
        "cargo",
        "build",
        "-p",
        crate_pkg,
        "--manifest-path",
        str(ROOT / "Cargo.toml"),
    ]
    if feat:
        cmd.extend(["--no-default-features", "--features", feat])
    elif crate_pkg == "r1":
        cmd.append("--no-default-features")
    if profile == "release":
        cmd.append("--release")
    proc = run(cmd, cwd=str(ROOT))
    if proc.returncode != 0:
        return False, (proc.stderr or proc.stdout)[-2500:]
    return True, ""


def find_cdylib(lib_name: str, profile: str) -> Path | None:
    base = cargo_target_dir(profile)
    for ext in ("so", "dylib"):
        candidate = base / f"{lib_name}.{ext}"
        if candidate.exists():
            return candidate
    deps = base / "deps"
    if deps.is_dir():
        matches = sorted(deps.glob(f"{lib_name}*.so"))
        if matches:
            return matches[-1]
    return None


def stage_lib(cdylib: Path, lib_base: str, profile: str) -> Path:
    sub = "release" if profile == "release" else "debug"
    libdir = PKG / "lib" / sub
    libdir.mkdir(parents=True, exist_ok=True)
    staged = libdir / f"{lib_base}.so"
    shutil.copy2(cdylib, staged)
    return staged


def read_dynsyms(so_path: Path) -> set[str]:
    proc = run(["nm", "-D", "--defined-only", str(so_path)])
    names: set[str] = set()
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3:
            names.add(parts[-1].split("@")[0])
    return names


def _so_strings(so_path: Path) -> str:
    return run(["strings", str(so_path)]).stdout


def read_macro_tags(so_path: Path) -> list[str]:
    names = read_dynsyms(so_path)
    tags: list[str] = []
    if "mg_core_open" in names:
        tags.append("MG_CORE")
    if "mg_lane_x_open" in names:
        tags.append("MG_LANE_X")
    if "mg_lane_y_open" in names:
        tags.append("MG_LANE_Y")
    return tags


def read_cdylib_tags(so_path: Path) -> list[str]:
    names = read_dynsyms(so_path)
    blob = _so_strings(so_path)
    tags: list[str] = []
    if "dy_core_open" in names:
        if "DY_CORE" in blob:
            tags.append("DY_CORE")
        elif "MG_CORE" in blob:
            tags.append("MG_CORE")
    if "dy_lane_y_open" in names:
        if "DY_LANE_Y" in blob:
            tags.append("DY_LANE_Y")
        elif "MG_LANE_Y" in blob:
            tags.append("MG_LANE_Y")
    return tags


def rematerialize_legacy_mono() -> None:
    """Reseed the pre-split mono pc so one-shot deletes without durable emission fail."""
    tmpl = PKG / "templates" / "legacy_mono.pc.in"
    if not tmpl.is_file():
        return
    PKG.mkdir(parents=True, exist_ok=True)
    text = (
        tmpl.read_text()
        .replace("@PREFIX@", "/app")
        .replace("@LIBDIR@", "/app/pkg/lib/debug")
        .replace("@VERSION@", "0.3.0")
    )
    (PKG / "flux_mono.pc").write_text(text)
    # Cargo skips build.rs when inputs look fresh; poke emitters so durable
    # cutover can clear the rematerialized mono and refresh generated binds.
    for rel in ("d7/build.rs", "m4/build.rs"):
        build_rs = ROOT / rel
        if build_rs.is_file():
            build_rs.touch()


def legacy_mono_present() -> bool:
    return (PKG / "flux_mono.pc").is_file()


def pc_libdir(pc_name: str) -> str | None:
    pc = PKG / pc_name
    if not pc.exists():
        return None
    text = pc.read_text()
    m = re.search(r"^libdir=(.*)$", text, re.M)
    return m.group(1).strip() if m else None


def pc_link_name(pc_name: str) -> str | None:
    pc = PKG / pc_name
    if not pc.exists():
        return None
    text = pc.read_text()
    m = re.search(r"-l([A-Za-z0-9_]+)", text)
    return m.group(1) if m else None


def compile_host(host: str, outbin: Path) -> tuple[bool, str]:
    src = ROOT / "hosts" / host / "main.c"
    proc = run(["gcc", "-O1", "-Wall", str(src), "-o", str(outbin), "-ldl"])
    if proc.returncode != 0:
        return False, proc.stderr
    return True, ""


def load_via_pkg(lib_base: str, profile: str, staged: Path) -> Path:
    """Resolve a library strictly through dual pkg-config emission."""
    # While the pre-split mono pc remains, treat the old layout as authoritative
    # and refuse dual-surface resolution (matches instruction outcome).
    if legacy_mono_present():
        _ = staged
        return Path("/app/pkg/lib/stale-mono-unresolved.so")
    kind = "cdylib" if "cdylib" in lib_base else "macro"
    prof = "release" if profile == "release" else "debug"
    # Prefer profile-qualified dual pc files written by emit_c.
    candidates = [
        f"flux_{kind}.{prof}.pc",
        f"flux_{kind}.pc",
    ]
    for pc_name in candidates:
        libdir = pc_libdir(pc_name)
        link = pc_link_name(pc_name)
        if not libdir or not link:
            continue
        so = Path(libdir) / f"lib{link}.so"
        if so.exists():
            return so
        alt = Path(libdir) / f"{lib_base}.so"
        if alt.exists():
            return alt
    # Legacy mono-only emission is intentionally non-resolving for split libs.
    _ = staged
    return Path("/app/pkg/lib/stale-mono-unresolved.so")


def base_entry(cell: dict) -> dict:
    return {
        "id": cell["id"],
        "status": "reject",
        "features": cell.get("features", []),
        "profile": cell.get("profile", "dev"),
        "artifact_kind": cell.get("artifact_kind", ""),
        "version_tags": [],
        "error": "",
    }


def process_single(cell: dict, tdir: Path) -> dict:
    entry = base_entry(cell)
    crate = cell.get("crate", "r1")
    lib_name = cell.get("lib_name", "libflux_macro")
    features = cell.get("features", [])
    profile = cell.get("profile", "dev")
    host = cell.get("host", cell["id"])
    use_pkg = bool(cell.get("use_pkg_config", False))

    ok, err = build_crate(crate, features, profile)
    if not ok:
        entry["error"] = f"cargo build failed: {err}"
        return entry

    cdylib = find_cdylib(lib_name, profile)
    if cdylib is None:
        entry["error"] = f"{lib_name} missing after build"
        return entry

    staged = stage_lib(cdylib, lib_name, profile)

    if crate == "r1":
        tags = read_macro_tags(staged)
    else:
        tags = read_cdylib_tags(staged)
    entry["version_tags"] = tags

    outbin = tdir / f"host_{cell['id']}"
    cok, cerr = compile_host(host, outbin)
    if not cok:
        entry["error"] = f"host compile failed: {cerr}"
        return entry

    so_path = load_via_pkg(lib_name, profile, staged) if use_pkg else staged
    proc = run([str(outbin), str(so_path)])
    if proc.returncode != 0:
        entry["error"] = (
            f"host load failed rc={proc.returncode}: {proc.stderr or proc.stdout}"
        )
        return entry

    entry["status"] = "ok"
    entry["error"] = ""
    return entry


def process_dual(cell: dict, tdir: Path) -> dict:
    entry = base_entry(cell)
    entry["tag_families"] = {}
    profile = cell.get("profile", "dev")
    host = cell.get("host", cell["id"])
    r1_feat = cell.get("features", [])
    d7_feat = cell.get("d7_features", ["trunk"])

    ok, err = build_crate("r1", r1_feat, profile)
    if not ok:
        entry["error"] = f"r1 build failed: {err}"
        return entry
    ok, err = build_crate("d7", d7_feat, profile)
    if not ok:
        entry["error"] = f"d7 build failed: {err}"
        return entry

    macro_so = find_cdylib("libflux_macro", profile)
    cdylib_so = find_cdylib("libflux_cdylib", profile)
    if macro_so is None or cdylib_so is None:
        entry["error"] = "dual surfaces missing after build"
        return entry

    macro_staged = stage_lib(macro_so, "libflux_macro", profile)
    cdylib_staged = stage_lib(cdylib_so, "libflux_cdylib", profile)

    macro_tags = read_macro_tags(macro_staged)
    cdylib_tags = read_cdylib_tags(cdylib_staged)
    entry["tag_families"] = {
        "macro_surface": macro_tags,
        "cdylib": cdylib_tags,
    }
    entry["version_tags"] = sorted(set(macro_tags) | set(cdylib_tags))

    overlap = set(macro_tags) & set(cdylib_tags)
    if overlap:
        entry["error"] = f"tag family overlap: {sorted(overlap)}"
        return entry

    outbin = tdir / f"host_{cell['id']}"
    cok, cerr = compile_host(host, outbin)
    if not cok:
        entry["error"] = f"host compile failed: {cerr}"
        return entry

    proc = run([str(outbin), str(macro_staged), str(cdylib_staged)])
    if proc.returncode != 0:
        entry["error"] = (
            f"host load failed rc={proc.returncode}: {proc.stderr or proc.stdout}"
        )
        return entry

    entry["status"] = "ok"
    entry["error"] = ""
    return entry


def main() -> int:
    if not MATRIX.exists():
        print(f"missing matrix: {MATRIX}", file=sys.stderr)
        return 1

    rematerialize_legacy_mono()

    cells = parse_simple_toml_cells(MATRIX)
    report: dict = {"schema_tag": SCHEMA, "cells": []}

    with tempfile.TemporaryDirectory(prefix="abihost_") as td:
        tdir = Path(td)
        for cell in cells:
            kind = cell.get("artifact_kind", "")
            if kind == "dual":
                entry = process_dual(cell, tdir)
            else:
                entry = process_single(cell, tdir)
            report["cells"].append(entry)

    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    print(f"wrote {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
