# syntax=docker/dockerfile:1
#
# Canonical Java runtime (Language runtimes — Dockerfile & Image Best Practices §2).
# Cutover preference sheets are rebuilt with javac/make at runtime, so the JDK stays in the final stage.

FROM public.ecr.aws/docker/library/eclipse-temurin:21-jdk-jammy@sha256:25d1276565738d3c805e632a4542c3a7598866ef967f4def6544c15de3a74b14

LABEL org.opencontainers.image.source="terminal-bench-3" \
      org.opencontainers.image.title="pkcs11-multi-slot-session-rebind" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    HOME=/tmp \
    TMUX_TMPDIR=/tmp \
    XDG_CONFIG_HOME=/tmp/.config

WORKDIR /app

# 1. OS / agent session tools + rebuild toolchain + verifier Python (one apt transaction)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        asciinema=2.1.0-1 \
        ca-certificates=20260601~22.04.1 \
        make=4.3-4.1build1 \
        python3=3.10.6-1~22.04.1 \
        python3-pip=22.0.2+dfsg-1ubuntu0.7 \
        python-is-python3=3.9.2-2 \
        tmux=3.2a-4ubuntu0.2 \
    && rm -rf /var/lib/apt/lists/*

RUN install -d -m 1777 /tmp \
    && install -d -m 0777 /tmp/.config /tmp/.config/asciinema \
    && tmux -V \
    && asciinema --version \
    && tmux new-session -d -s _smoke \
    && tmux has-session -t _smoke \
    && tmux kill-session -t _smoke

# 2. Verifier deps (pinned; offline at agent/verifier runtime)
RUN pip3 install --no-cache-dir \
    pytest==8.4.1 \
    pytest-json-ctrf==0.3.5

# 3. Runtime directories used by helpers and fixtures (do not create Harbor-reserved
# /logs/verifier or /logs/agent — the platform mounts those).
RUN mkdir -p /opt/pk11/bin /opt/pk11/classes /opt/pk11/config /opt/pk11/scripts \
        /opt/pk11/config/slot_overrides /opt/pk11/scenarios \
        /output /data/token /data/fixtures /data/fixtures/token-seed \
    && chmod 0777 /output /data /data/token /data/fixtures /app /opt/pk11

# 4. Build manifests and sources (more volatile)
COPY Makefile /app/Makefile
COPY lib/ /app/lib/
COPY flux/ /app/flux/
COPY nest/ /app/nest/
COPY forge/ /app/forge/
COPY cmd/ /app/cmd/
COPY config/ /app/config/
COPY data/scenarios/ /opt/pk11/scenarios/
COPY --chmod=0755 scripts/ /opt/pk11/scripts/
COPY --chmod=0755 data/build_fixtures.sh /tmp/build_fixtures.sh

# 5. Install helpers, seal ops+gate jars (drop engine sources), seed token state.
# Seed material is generated by build_fixtures.sh (do not COPY data/fixtures/ —
# empty fixture trees break Daytona/BuildKit cache keying with "/data/fixtures: not found").
RUN make install \
    && make seal-ops \
    && make seal-gate \
    && make install \
    && test -f /opt/pk11/lib/gate.jar \
    && test -f /opt/pk11/lib/ops.jar \
    && test ! -f /app/lib/Vx.java \
    && test ! -f /app/flux/OpA.java \
    && test ! -f /app/lib/SealUtil.java \
    && test ! -f /app/cmd/wireapply/Main.java \
    && test ! -f /app/cmd/holdrun/Main.java \
    && test ! -f /app/cmd/emitout/Main.java \
    && test ! -f /opt/pk11/classes/lib/Vx.class \
    && test ! -f /opt/pk11/classes/flux/OpA.class \
    && test ! -f /opt/pk11/classes/wireapply/Main.class \
    && sha256sum /opt/pk11/lib/ops.jar > /tmp/ops.sum \
    && cut -d' ' -f1 /tmp/ops.sum > /opt/pk11/lib/ops.sha256 \
    && test -s /opt/pk11/lib/ops.sha256 \
    && rm -f /tmp/ops.sum \
    && cp -f /app/config/*.toml /opt/pk11/config/ \
    && mkdir -p /opt/pk11/config/slot_overrides \
    && cp -f /app/config/slot_overrides/*.toml /opt/pk11/config/slot_overrides/ \
    && test -f /opt/pk11/config/slot_overrides/17.toml \
    && test -f /opt/pk11/scenarios/beta/inventory.txt \
    && test -f /opt/pk11/scenarios/gamma/inventory.txt \
    && /tmp/build_fixtures.sh \
    && rm -f /tmp/build_fixtures.sh \
    && chmod +x /opt/pk11/scripts/*.sh \
    && java -version \
    && javac -version \
    && test -x /opt/pk11/bin/authcheck \
    && test -x /opt/pk11/bin/findscan \
    && test -x /opt/pk11/bin/sealgen \
    && test -f /data/fixtures/token-seed/marker.txt \
    && test -f /data/token/restore.journal \
    && grep -q '^01:' /data/token/restore.journal \
    && ! grep -qi 'revoked_epoch=' /data/token/restore.journal \
    && ! grep -qi 'ceremony_ref=' /data/token/restore.journal \
    && ! grep -qi 'claimed_lane=' /data/token/restore.journal \
    && ! test -f /app/lib/SealExpect.java


WORKDIR /app
