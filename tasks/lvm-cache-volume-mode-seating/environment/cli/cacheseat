#!/bin/bash
# cacheseat — publish the seating ledger from prepared desk state.
set -euo pipefail

OUT="${SEAT_OUT:-/output/lvmcache-seat.json}"
ROSTER="${ROSTER:-/etc/lvm/roster.list}"
ROOT="${LVM_ROOT:-/var/lib/lvm}"
STATE="$ROOT/state"
OPS="$ROOT/ops"
EFF="${EFF_POLICY:-/etc/lvm/effective.conf}"
SHEET_D="${SHEET_D:-/etc/lvm/cache.d}"
VOL_D="$ROOT/volumes"

mkdir -p "$(dirname "$OUT")"

python3 - "$OUT" "$ROSTER" "$STATE" "$OPS" "$EFF" "$SHEET_D" "$VOL_D" <<'PY'
import json
import sys
from pathlib import Path

out, roster, state, ops, eff, sheet_d, vol_d = map(Path, sys.argv[1:])


def pairs(path):
    data = {}
    if not path.exists():
        return data
    for line in path.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        a, b = line.split("=", 1)
        data[a.strip()] = b.strip().strip('"')
    return data


def scalar(path, default=""):
    if not path.exists():
        return default
    return path.read_text().strip()


names = [
    ln.strip()
    for ln in roster.read_text().splitlines()
    if ln.strip() and not ln.strip().startswith("#")
]

policy = pairs(eff)
guard = policy.get("abort", "none")
sealed_pool = pairs(ops / "pool.map")
plane = pairs(ops / "prefer.toml").get("plane", "")
receipt = pairs(ops / "state" / "apply.ok")
target = scalar(state / "gen.target")
clock = int(scalar(state / "clock.epoch", "0") or 0)

windows = []
tsv = state / "holds.tsv"
if tsv.exists():
    for line in tsv.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            windows.append({"lv": parts[0], "until_epoch": int(parts[1])})
windows.sort(key=lambda w: w["lv"])

agree = (
    plane == "durable"
    and receipt.get("gen") == target
    and receipt.get("mode") == "seal"
    and scalar(state / "gen.live") == target
)

for w in windows:
    shut = scalar(state / f"hold_block_{w['lv']}") == "1"
    if shut != (w["until_epoch"] > clock):
        agree = False

rows = []
for name in names:
    sheet = pairs(sheet_d / f"{name}.conf")
    settled = scalar(state / f"tip_mode_{name}")
    pool = sealed_pool.get(name, "")
    vg = pairs(vol_d / f"{name}.toml").get("vg", "")
    try:
        gen = int(scalar(state / f"pub_{name}.gen", "0") or 0)
    except ValueError:
        gen = 0
    fit = bool(settled) and bool(pool)
    fit = fit and sheet.get("cache_mode", "") == settled
    fit = fit and sheet.get("pool_uuid", "") == pool
    ready = scalar(state / f"elig_{name}") == "1"
    shut = scalar(state / f"hold_block_{name}") == "1"
    if not fit or gen <= 0 or not vg:
        agree = False
    rows.append(
        {
            "name": name,
            "vg": vg,
            "mode": settled,
            "cachepool": pool,
            "generation": gen,
            "attached": bool(ready and not shut and fit and guard != name),
        }
    )

doc = {
    "schema_tag": "lvmcache-seat-v1",
    "volumes": rows,
    "holds": windows,
    "seat_ok": bool(agree),
}
out.write_text(json.dumps(doc, indent=2) + "\n")
PY
