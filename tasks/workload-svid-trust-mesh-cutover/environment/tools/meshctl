#!/bin/bash
set -euo pipefail
cd /app

cmd="${1:-}"
case "$cmd" in
  probe|bundlepub|tmrebind|tickgate|cutover|bundlecopy|tmalias|tickplan) ;;
  *)
    echo "usage: meshctl {probe|bundlepub|tmrebind|tickgate|cutover}" >&2
    exit 2
    ;;
esac

mkdir -p /app/m2/out /output /tmp/meshprobe-build /app/bin

mapfile -t java_srcs < <(find /app/m2/src -type f -name '*.java' | sort)
javac -d /app/m2/out "${java_srcs[@]}"

GOCACHE=/tmp/meshprobe-build/gocache
GOMODCACHE=/tmp/meshprobe-build/mod
export GOCACHE GOMODCACHE

go build -o /app/bin/meshprobe ./cmd/meshprobe
go build -o /app/bin/bundlepub ./cmd/bundlepub
go build -o /app/bin/tickgate ./cmd/tickgate
go build -o /app/bin/cutover ./cmd/cutover

install -m 0755 /app/tools/tmrebind /app/bin/tmrebind
install -m 0755 /app/tools/bundlecopy /app/bin/bundlecopy
install -m 0755 /app/tools/tmalias /app/bin/tmalias
install -m 0755 /app/tools/tickplan /app/bin/tickplan

case "$cmd" in
  probe) /app/bin/meshprobe; test -f /output/mesh-cutover.json ;;
  bundlepub) /app/bin/bundlepub ;;
  tmrebind) /app/bin/tmrebind ;;
  tickgate) /app/bin/tickgate ;;
  cutover) /app/bin/cutover ;;
  bundlecopy) /app/bin/bundlecopy ;;
  tmalias) /app/bin/tmalias ;;
  tickplan) /app/bin/tickplan ;;
esac
