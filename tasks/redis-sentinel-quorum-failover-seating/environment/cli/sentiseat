#!/bin/bash
# sentiseat — publish the seating ledger from prepared desk state.
set -euo pipefail

OUT="${SEAT_OUT:-/output/sentinel-seat.json}"
ROSTER="${ROSTER:-/etc/redis/roster.list}"
ROOT="${REDIS_ROOT:-/var/lib/redis}"
STATE="$ROOT/state"
OPS="$ROOT/ops"
EFF="${EFF_POLICY:-/etc/redis/effective.conf}"
MONITOR_D="${MONITOR_D:-/etc/redis/monitors.d}"
FLOOR_D="${FLOOR_D:-/var/lib/redis/floors}"
REPLICA_LIST="${REPLICA_LIST:-/etc/redis/replica.list}"

mkdir -p "$(dirname "$OUT")"

python3 - "$OUT" "$ROSTER" "$STATE" "$OPS" "$EFF" "$MONITOR_D" "$FLOOR_D" "$REPLICA_LIST" <<'PY'
import json
import sys
from pathlib import Path

out, roster, state, ops, eff, monitor_d, floor_d, replica_list = map(
    Path, sys.argv[1:]
)


def pairs(path):
    data = {}
    if not path.exists():
        return data
    for line in path.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        a, b = line.split("=", 1)
        data[a.strip()] = b.strip().strip('"')
    return data


def scalar(path, default=""):
    if not path.exists():
        return default
    return path.read_text().strip()


def live_monitor_addr(name):
    conf = monitor_d / f"{name}.conf"
    if not conf.exists():
        return ""
    for line in conf.read_text().splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[0] == "sentinel" and parts[1] == "monitor":
            return f"{parts[3]}:6379"
    return ""


names = [
    ln.strip()
    for ln in roster.read_text().splitlines()
    if ln.strip() and not ln.strip().startswith("#")
]

policy = pairs(eff)
guard = policy.get("abort", "none")
plane = pairs(ops / "prefer.toml").get("plane", "")
receipt = pairs(ops / "state" / "apply.ok")
target = scalar(state / "gen.target")

agree = (
    plane == "durable"
    and receipt.get("gen") == target
    and receipt.get("mode") == "seal"
    and scalar(state / "gen.live") == target
)

masters = []
for name in names:
    addr = scalar(state / f"tip_{name}.addr")
    try:
        gen = int(scalar(state / f"pub_{name}.gen", "0") or 0)
    except ValueError:
        gen = 0
    try:
        floor = int(scalar(floor_d / f"{name}.floor", "0") or 0)
    except ValueError:
        floor = 0
    ready = scalar(state / f"elig_{name}") == "1"
    qok = scalar(state / f"quorum_{name}") == "1"
    live = live_monitor_addr(name)
    want_ready = gen >= floor and gen > 0
    if ready != want_ready:
        agree = False
    if addr != live or not addr:
        agree = False
    auth = bool(ready and qok and addr and addr == live and guard != name and want_ready)
    masters.append(
        {
            "name": name,
            "addr": addr,
            "generation": gen,
            "authoritative": auth,
        }
    )

replicas = []
rep = state / "replicas.tsv"
if rep.exists():
    for line in rep.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) >= 4:
            replicas.append(
                {
                    "master": parts[0],
                    "addr": parts[1],
                    "lag": int(parts[2]),
                    "attached": parts[3] == "1",
                }
            )

expected = []
if replica_list.exists():
    for line in replica_list.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line or "|" not in line:
            continue
        m, addr, reported, lag_s = line.split("|", 3)
        tip = scalar(state / f"tip_{m}.addr")
        expected.append(
            {
                "master": m,
                "addr": addr,
                "lag": int(lag_s),
                "attached": reported == tip,
            }
        )

if len(expected) != len(replicas):
    agree = False
else:
    for got, want in zip(replicas, expected):
        if got != want:
            agree = False

doc = {
    "schema_tag": "sentinel-seat-v1",
    "masters": masters,
    "replicas": replicas,
    "seat_ok": bool(agree and len(masters) == len(names) and len(replicas) == len(expected)),
}
out.write_text(json.dumps(doc, separators=(",", ":"), sort_keys=False) + "\n")
PY
