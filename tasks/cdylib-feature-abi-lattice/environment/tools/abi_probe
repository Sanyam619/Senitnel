#!/usr/bin/env python3
"""Build the host matrix and emit /output/abi-matrix.json."""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path("/app")
OUT = Path("/output/abi-matrix.json")
MATRIX = ROOT / "ops" / "matrix.toml"
NOTES = ROOT / "link" / "abi_notes.toml"
PKG = ROOT / "pkg"

CRATE_MAP = {
    "nuclide": ("q3", "libnuclide"),
    "cascade": ("q5", "libcascade"),
}


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        text=True,
        capture_output=True,
        check=False,
        **kwargs,
    )


def parse_simple_toml_cells(path: Path) -> list[dict]:
    cells: list[dict] = []
    cur: dict | None = None
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line == "[[cells]]":
            if cur:
                cells.append(cur)
            cur = {}
            continue
        if cur is None or "=" not in line:
            continue
        key, val = [p.strip() for p in line.split("=", 1)]
        if val.startswith("["):
            inner = val.strip("[]")
            cur[key] = [x.strip().strip('"') for x in inner.split(",") if x.strip()]
        elif val in ("true", "false"):
            cur[key] = val == "true"
        else:
            cur[key] = val.strip('"')
    if cur:
        cells.append(cur)
    return cells


def parse_notes(path: Path) -> dict:
    data: dict = {}
    current_lib = None
    current_cell = None
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and not line.startswith("[["):
            parts = line.strip("[]").split(".")
            if len(parts) == 1:
                current_lib = parts[0]
                current_cell = None
                if current_lib not in data:
                    data[current_lib] = {
                        "soname": "",
                        "symbol_versions": [],
                        "cells": {},
                    }
            elif len(parts) == 3 and parts[1] == "cells":
                current_cell = parts[2]
                if current_lib and current_cell not in data[current_lib]["cells"]:
                    data[current_lib]["cells"][current_cell] = {
                        "required_versions": [],
                        "required_symbols": [],
                        "forbidden_symbols": [],
                    }
            continue
        if "=" not in line:
            continue
        key, val = [p.strip() for p in line.split("=", 1)]
        if val.startswith("["):
            inner = val.strip("[]")
            parsed = [x.strip().strip('"') for x in inner.split(",") if x.strip()]
        else:
            parsed = val.strip('"')
        if current_cell and current_lib:
            data[current_lib]["cells"][current_cell][key] = parsed
        elif current_lib:
            data[current_lib][key] = parsed
    return data


def cargo_target_dir(profile: str) -> Path:
    if profile == "release":
        return ROOT / "target" / "release"
    return ROOT / "target" / "debug"


def build_crate(crate_pkg: str, features: list[str], profile: str) -> tuple[bool, str]:
    feat = ",".join(features)
    cmd = [
        "cargo",
        "build",
        "-p",
        crate_pkg,
        "--no-default-features",
        "--features",
        feat,
        "--manifest-path",
        str(ROOT / "Cargo.toml"),
    ]
    if profile == "release":
        cmd.append("--release")
    proc = run(cmd, cwd=str(ROOT))
    if proc.returncode != 0:
        return False, proc.stderr[-2000:]
    return True, ""


def find_cdylib(lib_name: str, profile: str) -> Path | None:
    base = cargo_target_dir(profile)
    for ext in ("so", "dylib"):
        candidate = base / f"{lib_name}.{ext}"
        if candidate.exists():
            return candidate
    deps = base / "deps"
    if deps.is_dir():
        matches = sorted(deps.glob(f"{lib_name}*.so"))
        if matches:
            return matches[-1]
    return None


def emit_meta(soname: str, tags: list[str]) -> None:
    PKG.mkdir(parents=True, exist_ok=True)
    tags_csv = ",".join(tags)
    proc = run(
        [
            "cargo",
            "run",
            "-q",
            "-p",
            "k9",
            "--manifest-path",
            str(ROOT / "Cargo.toml"),
            "--",
            str(PKG),
            soname,
            tags_csv,
        ],
        cwd=str(ROOT),
    )
    if proc.returncode != 0:
        raise RuntimeError(f"meta_emit failed: {proc.stderr}")


def stage_lib(cdylib: Path, soname: str, lib_base: str) -> Path:
    libdir = PKG / "lib"
    libdir.mkdir(parents=True, exist_ok=True)
    staged = libdir / f"{lib_base}.so"
    shutil.copy2(cdylib, staged)
    link = libdir / soname
    if link.exists() or link.is_symlink():
        link.unlink()
    if soname != f"{lib_base}.so":
        link.symlink_to(staged.name)
    return staged


def read_dynsyms(so_path: Path) -> set[str]:
    proc = run(["nm", "-D", "--defined-only", str(so_path)])
    names: set[str] = set()
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3:
            names.add(parts[-1].split("@")[0])
    return names


def read_nuclide_versions(so_path: Path) -> list[str]:
    names = read_dynsyms(so_path)
    found: list[str] = []
    if "nx_trunk_open" in names:
        found.append("NEXUS_1")
    if "nx_abi_tag_v2" in names:
        found.append("NEXUS_2")
    if "nx_facet_b_open" in names:
        found.append("NEXUS_1B")
    return found


def read_cascade_versions(so_path: Path) -> list[str]:
    names = read_dynsyms(so_path)
    found: list[str] = []
    if "cx_trunk_open" in names:
        found.append("CASCADE_1")
    if "cx_facet_c_open" in names:
        found.append("CASCADE_1C")
    return found


def pc_lib_name() -> str | None:
    pc = PKG / "nuclide.pc"
    if not pc.exists():
        return None
    text = pc.read_text()
    m = re.search(r"-l([A-Za-z0-9_]+)", text)
    return m.group(1) if m else None


def compile_host(host: str, outbin: Path) -> tuple[bool, str]:
    src = ROOT / "hosts" / host / "main.c"
    cmd = [
        "gcc",
        "-O1",
        "-Wall",
        str(src),
        "-o",
        str(outbin),
        "-ldl",
    ]
    proc = run(cmd)
    if proc.returncode != 0:
        return False, proc.stderr
    return True, ""


def load_path_for_cell(use_pkg: bool, staged: Path, soname: str) -> Path:
    if not use_pkg:
        return staged
    libname = pc_lib_name() or "nuclide"
    candidate = PKG / "lib" / f"lib{libname}.so"
    if candidate.exists():
        return candidate
    alt = PKG / "lib" / soname
    if alt.exists():
        return alt
    return staged


def process_single_lib_cell(
    cell: dict,
    notes: dict,
    tdir: Path,
) -> dict:
    cid = cell["id"]
    lib = cell.get("lib", "nuclide")
    crate_pkg, lib_base = CRATE_MAP[lib]
    features = cell.get("features", ["trunk"])
    profile = cell.get("profile", "dev")
    host = cell.get("host", cid)
    expect_versions = cell.get("expect_versions", [])
    use_pkg = bool(cell.get("use_pkg_config", False))
    lib_notes = notes.get(lib, {})

    entry = {
        "id": cid,
        "lib": lib,
        "status": "reject",
        "profile": profile,
        "features": features,
        "soname": "",
        "symbol_versions": [],
        "error": "",
    }

    ok, err = build_crate(crate_pkg, features, profile)
    if not ok:
        entry["error"] = f"cargo build failed: {err}"
        return entry

    cdylib = find_cdylib(lib_base, profile)
    if cdylib is None:
        entry["error"] = f"{lib_base} cdylib missing after build"
        return entry

    try:
        emit_meta(lib_notes.get("soname", ""), lib_notes.get("symbol_versions", []))
    except RuntimeError as exc:
        entry["error"] = str(exc)
        return entry

    meta_soname = (PKG / "soname.txt").read_text().strip()
    meta_versions = [
        ln.strip()
        for ln in (PKG / "symbol_versions.txt").read_text().splitlines()
        if ln.strip()
    ]
    entry["soname"] = meta_soname

    staged = stage_lib(cdylib, lib_notes.get("soname", meta_soname), lib_base)

    if lib == "nuclide":
        versions = read_nuclide_versions(staged)
    else:
        versions = read_cascade_versions(staged)
    entry["symbol_versions"] = versions

    outbin = tdir / f"host_{cid}"
    cok, cerr = compile_host(host, outbin)
    if not cok:
        entry["error"] = f"host compile failed: {cerr}"
        return entry

    so_path = load_path_for_cell(use_pkg, staged, meta_soname)
    proc = run([str(outbin), str(so_path)])
    if proc.returncode != 0:
        entry["error"] = (
            f"host load failed rc={proc.returncode}: "
            f"{proc.stderr or proc.stdout}"
        )
        return entry

    missing_ver = [v for v in expect_versions if v not in versions]
    if missing_ver:
        entry["error"] = f"missing versions: {missing_ver}"
        return entry

    entry["status"] = "ok"
    entry["error"] = ""
    return entry


def process_dual_cell(
    cell: dict,
    notes: dict,
    tdir: Path,
) -> dict:
    cid = cell["id"]
    features = cell.get("features", ["trunk"])
    profile = cell.get("profile", "dev")
    host = cell.get("host", cid)
    expect_nuc = cell.get("expect_nuclide_versions", [])
    expect_cas = cell.get("expect_cascade_versions", [])
    nuc_notes = notes.get("nuclide", {})
    cas_notes = notes.get("cascade", {})

    entry = {
        "id": cid,
        "lib": "dual",
        "status": "reject",
        "profile": profile,
        "features": features,
        "nuclide_soname": "",
        "cascade_soname": "",
        "nuclide_versions": [],
        "cascade_versions": [],
        "error": "",
    }

    nuc_feat = [f for f in features if f != "facet_c"]
    ok, err = build_crate("q3", nuc_feat, profile)
    if not ok:
        entry["error"] = f"q3 build failed: {err}"
        return entry

    cas_feat = [f for f in features if f not in ("facet_a", "facet_b")]
    ok, err = build_crate("q5", cas_feat, profile)
    if not ok:
        entry["error"] = f"q5 build failed: {err}"
        return entry

    nuc_cdylib = find_cdylib("libnuclide", profile)
    cas_cdylib = find_cdylib("libcascade", profile)
    if nuc_cdylib is None:
        entry["error"] = "nuclide cdylib missing"
        return entry
    if cas_cdylib is None:
        entry["error"] = "cascade cdylib missing"
        return entry

    try:
        emit_meta(
            nuc_notes.get("soname", ""),
            nuc_notes.get("symbol_versions", []),
        )
    except RuntimeError as exc:
        entry["error"] = str(exc)
        return entry

    nuc_staged = stage_lib(
        nuc_cdylib, nuc_notes.get("soname", "libnuclide.so.2"), "libnuclide"
    )
    cas_staged = stage_lib(
        cas_cdylib, cas_notes.get("soname", "libcascade.so.1"), "libcascade"
    )

    entry["nuclide_soname"] = (PKG / "soname.txt").read_text().strip()
    nuc_versions = read_nuclide_versions(nuc_staged)
    cas_versions = read_cascade_versions(cas_staged)
    entry["nuclide_versions"] = nuc_versions
    entry["cascade_versions"] = cas_versions

    outbin = tdir / f"host_{cid}"
    cok, cerr = compile_host(host, outbin)
    if not cok:
        entry["error"] = f"host compile failed: {cerr}"
        return entry

    proc = run([str(outbin), str(nuc_staged), str(cas_staged)])
    if proc.returncode != 0:
        entry["error"] = (
            f"host load failed rc={proc.returncode}: "
            f"{proc.stderr or proc.stdout}"
        )
        return entry

    missing_nuc = [v for v in expect_nuc if v not in nuc_versions]
    missing_cas = [v for v in expect_cas if v not in cas_versions]
    if missing_nuc:
        entry["error"] = f"missing nuclide versions: {missing_nuc}"
        return entry
    if missing_cas:
        entry["error"] = f"missing cascade versions: {missing_cas}"
        return entry

    entry["status"] = "ok"
    entry["error"] = ""
    return entry


def main() -> int:
    if not MATRIX.exists():
        print(f"missing matrix: {MATRIX}", file=sys.stderr)
        return 1
    notes = parse_notes(NOTES)
    cells = parse_simple_toml_cells(MATRIX)

    report: dict = {
        "nuclide_soname": "",
        "cascade_soname": "",
        "nuclide_versions": [],
        "cascade_versions": [],
        "cells": {},
    }

    with tempfile.TemporaryDirectory(prefix="abihost_") as td:
        tdir = Path(td)
        for cell in cells:
            cid = cell["id"]
            lib = cell.get("lib", "nuclide")

            if lib == "dual":
                entry = process_dual_cell(cell, notes, tdir)
                if entry.get("nuclide_soname"):
                    report["nuclide_soname"] = entry["nuclide_soname"]
                if entry.get("nuclide_versions"):
                    report["nuclide_versions"] = entry["nuclide_versions"]
                if entry.get("cascade_versions"):
                    report["cascade_versions"] = entry["cascade_versions"]
            else:
                entry = process_single_lib_cell(cell, notes, tdir)
                if lib == "nuclide" and entry.get("soname"):
                    report["nuclide_soname"] = entry["soname"]
                    report["nuclide_versions"] = entry.get(
                        "symbol_versions", []
                    )
                elif lib == "cascade" and entry.get("soname"):
                    report["cascade_soname"] = entry["soname"]
                    report["cascade_versions"] = entry.get(
                        "symbol_versions", []
                    )
            report["cells"][cid] = entry

    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    print(f"wrote {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
