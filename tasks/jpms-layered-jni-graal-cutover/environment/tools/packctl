#!/usr/bin/env python3
"""Packaging probe orchestrator for layered JPMS / JNI / native cutover."""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

APP = Path("/app")
BUILD = APP / "build"
OUT = Path("/output/pack-report.json")
JAVA_HOME = Path(os.environ.get("JAVA_HOME", "/opt/java/openjdk"))
if not (JAVA_HOME / "bin/javac").exists():
    for cand in (Path("/usr/lib/jvm/java-21-openjdk-amd64"), Path("/opt/java/openjdk")):
        if (cand / "bin/javac").exists():
            JAVA_HOME = cand
            break
os.environ["JAVA_HOME"] = str(JAVA_HOME)
os.environ["PATH"] = f"{JAVA_HOME}/bin:{os.environ.get('PATH', '')}"


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=True, text=True, capture_output=True, **kw)


def _toml_bool(text: str, key: str, default: bool = False) -> bool:
    m = re.search(rf"^{re.escape(key)}\s*=\s*(true|false)\s*$", text, re.M | re.I)
    if not m:
        return default
    return m.group(1).lower() == "true"


def active_profile() -> dict:
    runtime = APP / "data/state/runtime.json"
    name = "field"
    if runtime.is_file():
        try:
            name = str(json.loads(runtime.read_text(encoding="utf-8")).get("active_profile") or "field")
        except Exception:
            name = "field"
    path = APP / "config/profiles" / f"{name}.toml"
    text = path.read_text(encoding="utf-8") if path.is_file() else ""
    return {
        "name": name,
        "bind_services": _toml_bool(text, "bind_services", False),
        "shade_bridge": _toml_bool(text, "shade_bridge", True),
        "path": str(path),
    }


def compile_units() -> Path:
    mods = BUILD / "mods"
    if mods.exists():
        shutil.rmtree(mods)
    mods.mkdir(parents=True)

    def jc(dest: Path, sources: list[Path], mp: list[Path] | None = None) -> None:
        dest.mkdir(parents=True, exist_ok=True)
        cmd = ["javac", "-d", str(dest)]
        if mp:
            cmd += ["--module-path", ":".join(str(p) for p in mp)]
        cmd += [str(s) for s in sources]
        run(cmd)

    a1 = APP / "unit/a1"
    jc(mods / "helix.api", [a1 / "module-info.java", a1 / "io/helix/api/Slot.java"])

    b2 = APP / "unit/b2"
    jc(
        mods / "helix.spi",
        [
            b2 / "module-info.java",
            b2 / "io/helix/spi/SlotProvider.java",
            b2 / "io/helix/spi/SpiMark.java",
        ],
        [mods / "helix.api"],
    )
    svc = mods / "helix.spi/META-INF/services"
    svc.mkdir(parents=True, exist_ok=True)
    shutil.copy2(b2 / "META-INF/services/io.helix.api.Slot", svc / "io.helix.api.Slot")

    c3 = APP / "unit/c3"
    jc(mods / "helix.bridge", [c3 / "module-info.java", c3 / "io/helix/bridge/NativeHook.java"])

    d4 = APP / "unit/d4"
    jc(
        mods / "helix.app",
        [d4 / "module-info.java", d4 / "io/helix/app/Main.java"],
        [mods / "helix.api", mods / "helix.bridge"],
    )
    return mods


def compile_drivers() -> Path:
    drvlib = BUILD / "drvlib"
    if drvlib.exists():
        shutil.rmtree(drvlib)
    drvlib.mkdir(parents=True)
    for name, root in (
        ("helix.kz", APP / "k9"),
        ("helix.qx", APP / "p7"),
        ("helix.ry", APP / "m2"),
    ):
        src = root / "src/main/java"
        files = list(src.rglob("*.java"))
        dest = drvlib / name
        dest.mkdir(parents=True)
        run(["javac", "-d", str(dest)] + [str(f) for f in files])
    return drvlib


def build_native() -> Path:
    native = APP / "native"
    inc = JAVA_HOME / "include"
    if sys.platform == "darwin":
        plat = "darwin"
        libname = "libhelixhook.dylib"
    else:
        plat = "linux"
        libname = "libhelixhook.so"
    cflags = f"-fPIC -O2 -I{inc} -I{inc / plat}"
    so = native / libname
    run(["gcc"] + cflags.split() + ["-shared", "-o", str(so), str(native / "hook.c")])
    dest = BUILD / "lib"
    dest.mkdir(parents=True, exist_ok=True)
    shutil.copy2(so, dest / libname)
    if sys.platform == "darwin":
        shutil.copy2(so, dest / "libhelixhook.so")
    return dest


def driver_out(cp: Path, main: str, args: list[str]) -> list[str]:
    r = run(["java", "-cp", str(cp), main] + args)
    return [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]


def shade_hook(drvlib: Path, shade_bridge: bool) -> tuple[str, Path]:
    prefix = "io.helix.internal.bridge" if shade_bridge else ""
    lines = driver_out(
        drvlib / "helix.qx",
        "io.helix.qx.DriverP",
        ["io.helix.bridge.NativeHook", prefix],
    )
    fqcn = lines[0]
    shaded = BUILD / "shaded"
    if shaded.exists():
        shutil.rmtree(shaded)
    pkg = ".".join(fqcn.split(".")[:-1])
    simple = fqcn.split(".")[-1]
    pkg_path = shaded.joinpath(*pkg.split("."))
    pkg_path.mkdir(parents=True, exist_ok=True)
    src = pkg_path / f"{simple}.java"
    src.write_text(
        f"""package {pkg};

public final class {simple} {{
  static {{
    System.loadLibrary(\"helixhook\");
  }}
  private {simple}() {{}}
  public static native int ping(int x);
  public static int token() {{ return 17; }}
}}
""",
        encoding="utf-8",
    )
    run(["javac", "-d", str(shaded), str(src)])
    return fqcn, shaded


def write_reachability(drvlib: Path) -> list[str]:
    reflective = [
        "io.helix.app.Main",
        "io.helix.spi.SlotProvider",
        "io.helix.bridge.NativeHook",
    ]
    jni = ["io.helix.bridge.NativeHook"]
    lines = driver_out(
        drvlib / "helix.ry",
        "io.helix.ry.DriverM",
        reflective + ["--"] + jni,
    )
    names: list[str] = []
    if len(lines) > 1 and lines[1]:
        names = [n for n in lines[1].split(",") if n]
    meta = BUILD / "reachability"
    meta.mkdir(parents=True, exist_ok=True)
    entries = [{"name": n, "allDeclaredMethods": True} for n in names]
    (meta / "reflect-config.json").write_text(json.dumps(entries, indent=2), encoding="utf-8")
    return names


def _module_path(mods: Path) -> str:
    return ":".join(str(mods / m) for m in ("helix.api", "helix.spi", "helix.bridge", "helix.app"))


def _launch_roots(roots: list[str]) -> list[str]:
    available = [r for r in roots if r]
    for must in ("helix.app", "helix.api"):
        if must not in available:
            available.append(must)
    # Preserve order, drop dupes.
    return list(dict.fromkeys(available))


def probe_modular(
    mods: Path, lib: Path, roots: list[str], hook: str, shaded: Path, out_json: Path
) -> dict:
    mp = _module_path(mods)
    # Shaded hook classes live outside the module graph; put them on the classpath.
    cp = str(shaded)
    add = ",".join(_launch_roots(roots))
    cmd = [
        "java",
        "-Djava.library.path=" + str(lib),
        "--module-path",
        mp,
        "--class-path",
        cp,
        "--add-modules",
        add,
        "--add-reads",
        "helix.app=ALL-UNNAMED",
        "-m",
        "helix.app/io.helix.app.Main",
        str(out_json),
        hook,
    ]
    try:
        run(cmd)
        return json.loads(out_json.read_text(encoding="utf-8"))
    except Exception:
        return {"spi_bound": False, "jni_bridge": False, "token": -1, "hook": hook}


def probe_jlink(mods: Path, lib: Path, roots: list[str], hook: str, out_json: Path) -> dict:
    image = BUILD / "jlink-image"
    if image.exists():
        shutil.rmtree(image)
    mp = _module_path(mods)
    available = _launch_roots(roots)
    if hook.startswith("io.helix.bridge.") and "helix.bridge" not in available:
        available.append("helix.bridge")
        available = list(dict.fromkeys(available))
    add = ",".join(available)
    jlink_cmd = [
        "jlink",
        "--module-path",
        mp + ":" + str(JAVA_HOME / "jmods"),
        "--add-modules",
        add,
    ]
    if "helix.spi" in available:
        jlink_cmd.append("--bind-services")
    jlink_cmd += [
        "--output",
        str(image),
        "--strip-debug",
        "--no-header-files",
        "--no-man-pages",
    ]
    try:
        run(jlink_cmd)
    except subprocess.CalledProcessError:
        return {"spi_bound": False, "jni_bridge": False, "token": -1, "hook": hook}
    launcher = image / "bin" / "java"
    cmd = [
        str(launcher),
        "-Djava.library.path=" + str(lib),
        "-m",
        "helix.app/io.helix.app.Main",
        str(out_json),
        hook,
    ]
    try:
        run(cmd)
        return json.loads(out_json.read_text(encoding="utf-8"))
    except Exception:
        return {"spi_bound": False, "jni_bridge": False, "token": -1, "hook": hook}


def probe_native(
    mods: Path, lib: Path, roots: list[str], kept: list[str], hook: str, out_json: Path
) -> dict:
    # Native lane reuses the same root set as jlink so root selection and
    # reachability must both be coherent.
    spi_ok = "io.helix.spi.SlotProvider" in kept
    hook_ok = hook in kept and hook == "io.helix.bridge.NativeHook"
    jni = False
    spi = False
    if spi_ok and hook_ok:
        frag = BUILD / "native-frag.json"
        try:
            data = probe_modular(mods, lib, roots, hook, BUILD / "shaded", frag)
            jni = bool(data.get("jni_bridge"))
            spi = bool(data.get("spi_bound")) and spi_ok
        except Exception:
            jni = False
            spi = False
    result = {
        "spi_bound": spi,
        "jni_bridge": jni,
        "reflect_kept": list(kept),
        "hook": hook,
    }
    out_json.write_text(json.dumps(result), encoding="utf-8")
    return result


def mode_status(mode: str, data: dict) -> str:
    if mode == "jvm":
        return "ok" if data.get("spi_bound") and data.get("jni_bridge") else "degraded"
    if mode == "jlink":
        return "ok" if data.get("spi_bound") else "degraded"
    if mode == "native":
        return "ok" if data.get("spi_bound") and data.get("jni_bridge") else "degraded"
    return "degraded"


def main() -> int:
    BUILD.mkdir(parents=True, exist_ok=True)
    Path("/output").mkdir(parents=True, exist_ok=True)
    profile = active_profile()
    mods = compile_units()
    drvlib = compile_drivers()
    lib = build_native()

    root_args = ["helix.app", "helix.api", "helix.spi", "helix.bridge"]
    if profile["bind_services"]:
        root_args.append("BIND")
    roots_lines = driver_out(drvlib / "helix.kz", "io.helix.kz.DriverK", root_args)
    roots = [r for r in roots_lines[0].split(",") if r]

    # Shade prefix stays aggressive during cutover; fold must pin JNI exports.
    # Profile shade_bridge is retained for roster visibility but does not bypass pin rules.
    _ = profile["shade_bridge"]
    hook, shaded = shade_hook(drvlib, True)
    kept = write_reachability(drvlib)

    jvm_frag = BUILD / "jvm.json"
    jlink_frag = BUILD / "jlink.json"
    native_frag = BUILD / "native.json"

    # All launch modes share the knit-selected root set (coupled lattice).
    jvm_data = probe_modular(mods, lib, roots, hook, shaded, jvm_frag)
    jlink_data = probe_jlink(mods, lib, roots, "io.helix.bridge.NativeHook", jlink_frag)
    native_data = probe_native(mods, lib, roots, kept, "io.helix.bridge.NativeHook", native_frag)

    report = {
        "probe_engine": "packctl-1",
        "profile": profile["name"],
        "modes": {
            "jvm": {
                "status": mode_status("jvm", jvm_data),
                "spi_bound": bool(jvm_data.get("spi_bound")),
                "jni_bridge": bool(jvm_data.get("jni_bridge")),
                "reflect_kept": [],
            },
            "jlink": {
                "status": mode_status("jlink", jlink_data),
                "spi_bound": bool(jlink_data.get("spi_bound")),
                "jni_bridge": bool(jlink_data.get("jni_bridge")),
                "reflect_kept": [],
            },
            "native": {
                "status": mode_status("native", native_data),
                "spi_bound": bool(native_data.get("spi_bound")),
                "jni_bridge": bool(native_data.get("jni_bridge")),
                "reflect_kept": list(native_data.get("reflect_kept") or []),
            },
        },
        "roots": roots,
        "hook": hook,
    }
    OUT.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {OUT}", flush=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as e:
        sys.stderr.write(e.stdout or "")
        sys.stderr.write(e.stderr or "")
        raise
